{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "^(edit|write|str_replace_editor)$",
        "bash": "./scripts/log-edit.sh",
        "timeoutSec": 5
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "./scripts/session-banner.sh",
        "timeoutSec": 5
      }
    ]
  }
}
